# Day 7 — sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.

# Vector store Day 6 (Docker project day6_student_starter, chỉ chạy local)
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Embedding dùng lại Day 6 (local, không cần key)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Agent model: Gemini API — lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Model phụ (cấu hình c_lite đã chọn)
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
# Giá paid tier (USD / 1M token) cho GEMINI_MODEL nếu model không có trong bảng PRICES (src/eval_agent.py).
# Để trống = chi phí "không rõ" (null), không phải 0.
GEMINI_PRICE_IN_PER_M=1.50
GEMINI_PRICE_OUT_PER_M=9.00
